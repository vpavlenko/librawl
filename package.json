{
  "name": "librawl",
  "version": "0.3.5-local",
  "description": "Shared Rawl React notation primitives and MIDI playback adapters",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vpavlenko/librawl.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js",
      "require": "./dist/components.cjs"
    },
    "./geometry": {
      "types": "./dist/geometry.d.ts",
      "import": "./dist/geometry.js",
      "require": "./dist/geometry.cjs"
    },
    "./palette": {
      "types": "./dist/palette.d.ts",
      "import": "./dist/palette.js",
      "require": "./dist/palette.cjs"
    },
    "./audio": {
      "types": "./dist/audio.d.ts",
      "import": "./dist/audio.js",
      "require": "./dist/audio.cjs"
    },
    "./style.css": "./dist/style.css",
    "./roman-numerals": {
      "types": "./dist/roman-numerals.d.ts",
      "import": "./dist/roman-numerals.js",
      "require": "./dist/roman-numerals.cjs"
    },
    "./roman-numerals.css": "./dist/roman-numerals.css",
    "./harmony-annotations": {
      "types": "./dist/harmony-annotations.d.ts",
      "import": "./dist/harmony-annotations.js",
      "require": "./dist/harmony-annotations.cjs"
    },
    "./harmony-annotations.css": "./dist/harmony-annotations.css",
    "./score-size-sliders.css": "./dist/score-size-sliders.css",
    "./piano-legend.css": "./dist/piano-legend.css",
    "./playback-footer.css": "./dist/playback-footer.css",
    "./browser/*": "./dist/browser/*",
    "./legacy-style.css": "./dist/legacy-style.css",
    "./harmony.css": "./dist/harmony.css",
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js",
      "require": "./dist/native.cjs"
    },
    "./native.css": "./dist/native.css",
    "./voice-shapes.css": "./dist/voice-shapes.css",
    "./native-audio": {
      "types": "./dist/native-audio.d.ts",
      "import": "./dist/native-audio.js",
      "require": "./dist/native-audio.cjs"
    },
    "./midi-output-worklet.js": "./dist/browser/midi-output-worklet.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "components.js",
    "components.d.ts",
    "audio.js",
    "audio.d.ts",
    "geometry.js",
    "geometry.d.ts",
    "palette.js",
    "palette.d.ts",
    "native.js",
    "native.d.ts",
    "native-audio.js",
    "native-audio.d.ts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=16.14 <20"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "lucide-react": "0.562.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dom16": "npm:react-dom@16.14.0",
    "react16": "npm:react@16.14.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs integrations/caplin/*.test.mjs",
    "check": "npm run build && npm test",
    "postbuild": "node scripts/sync-local-consumers.mjs --skip-build --when-enabled",
    "sync:local": "node scripts/sync-local-consumers.mjs",
    "watch:local": "node scripts/sync-local-consumers.mjs --watch"
  }
}
